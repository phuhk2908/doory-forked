# --- Core ---
DJANGO_SETTINGS_MODULE=doory.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public URL of the web app (used in emails and CSRF/CORS)
SITE_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (SQLite by default; use Postgres in production) ---
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://doory:doory@localhost:5432/doory

# --- Email ---
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Doory <no-reply@localhost>

# --- Google sign-in (optional). Web client ID from Google Cloud Console ---
GOOGLE_CLIENT_ID=

# --- Single sign-on with OpenID Connect (optional): Authentik, Keycloak, Zitadel... ---
# On when the issuer, client ID and secret are all set (docs/self-hosting/configuration.md).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_BUTTON_LABEL=Sign in with SSO
# OIDC_SCOPES=openid email profile
# OIDC_TRUST_EMAIL=false
# Logo on the button, e.g. authentik, keycloak, authelia, okta (list in docs/self-hosting/configuration.md)
OIDC_BUTTON_ICON=

# --- Media storage (local disk by default; set USE_S3=true for S3/MinIO/R2) ---
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
MAX_DRAWING_DOCUMENT_BYTES=12582912

# --- Image optimization (optional) ---
# The lightweight local setup does not install cjpeg/oxipng. Set this to builtin only when both are on PATH.
IMAGE_OPTIMIZERS=

# --- Stock photos and Freesound audio (optional; a provider is disabled when no key is set) ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Stock videos: keys of their own (optional; each falls back to the photo key above). Needs ffmpeg installed.
PEXELS_VIDEO_API_KEY=
PIXABAY_VIDEO_API_KEY=
FREESOUND_API_KEY=
# STOCK_PROVIDERS, STOCK_<PROVIDER>_RATE, STOCK_<PROVIDER>_CACHE_SECONDS, …: see the .env.example at the root.

# --- Real-time co-editing ---
# `make dev-api` serves WebSockets through daphne; the in-memory channel layer is right for one process.
# REALTIME_ENABLED=true
# REDIS_URL=redis://localhost:6379/0   # only to try several realtime workers (docker compose -f docker-compose.dev.yml --profile redis up -d)
# Guest-room safety: creation is an IP rate; the other limits apply to each anonymous room.
# DRAWING_ROOM_TTL_DAYS=30
# DRAWING_ROOM_AUDIT_RETENTION_DAYS=90
# DRAWING_ROOM_SPAM_SCORE_THRESHOLD=12
# DRAWING_ROOM_CREATE_RATE=10/min
# DRAWING_ROOM_MAX_COLLABORATORS=25
# DRAWING_ROOM_JOIN_RATE_PER_MINUTE=30
# DRAWING_ROOM_RATE_MESSAGES_PER_SECOND=30
# DRAWING_ROOM_RATE_BURST=90
# DRAWING_ROOM_RATE_BYTES_PER_SECOND=524288
# DRAWING_ROOM_RATE_BYTES_BURST=2097152
# DRAWING_ROOM_FANOUT_PER_SECOND=200
# DRAWING_ROOM_MEMBER_TTL_SECONDS=3600

# --- MCP server for AI assistants (optional; off by default) ---
# MCP_ENABLED=false
# MCP_CALLS_PER_MINUTE=120
# MCP_MAX_REQUEST_BYTES=4194304
# URL_IMAGE_UPLOADS=true
# MCP_EXPORT_INLINE_MAX_BYTES=1048576
# MCP_EXPORT_URL_TTL_SECONDS=600
