{
  "name": "doory-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run check && vite build",
    "bundle:report": "node scripts/bundleReport.mjs",
    "bundle:check": "node scripts/bundleReport.mjs --check",
    "preview": "vite preview",
    "lint": "oxlint .",
    "format": "oxfmt --write . --ignore-path .oxfmtignore",
    "format:check": "oxfmt --check . --ignore-path .oxfmtignore",
    "check": "bun check -b",
    "typecheck": "bun run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:editor": "playwright test -c playwright.editor.config.ts",
    "e2e:perf": "VITE_E2E=true vite build -c vite.perf.config.ts && playwright test -c playwright.perf.config.ts",
    "e2e:app": "playwright test -c playwright.app.config.ts",
    "e2e:app:prod": "vite build --outDir dist-app && E2E_APP_PROD=true playwright test -c playwright.app.config.ts",
    "e2e:collab": "VITE_E2E=true vite build --outDir dist-collab && playwright test -c playwright.collab.config.ts",
    "e2e:comments": "playwright test -c playwright.comments.config.ts",
    "e2e:print": "playwright test -c playwright.print.config.ts",
    "e2e:bg": "bun run build && playwright test -c playwright.bg.config.ts",
    "templates:build": "vite-node scripts/templates/build.ts --",
    "templates:qa": "vite-node scripts/templates/qa.ts --"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "fabric": "^7.2.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "jspdf": "^4.2.1",
    "lib0": "^0.2.119",
    "lucide-react": "^1.57.0",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.4.1",
    "onnxruntime-web": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "roughjs": "^4.6.6",
    "webm-muxer": "^5.1.4",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "canvas": "^3.2.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "msw": "^2.15.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "canvas"
  ]
}
